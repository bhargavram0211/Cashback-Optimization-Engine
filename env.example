# PostgreSQL Configuration
POSTGRES_USER=cashback_user
POSTGRES_PASSWORD=cashback_pass_local_dev_only
POSTGRES_DB=cashback_db

# Database URL (used by the backend)
DATABASE_URL=postgresql://cashback_user:cashback_pass_local_dev_only@db:5432/cashback_db

# Plaid API Configuration
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
