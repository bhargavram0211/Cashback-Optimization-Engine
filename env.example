# PostgreSQL Configuration
POSTGRES_USER=getcardiq_user
POSTGRES_PASSWORD=cashback_pass_local_dev_only
POSTGRES_DB=getcardiq_db

# Database URL (used by the backend)
DATABASE_URL=postgresql://getcardiq_user:cashback_pass_local_dev_only@db:5432/getcardiq_db

# Docker Image Configuration
# Docker Hub username (default: bhargavram0211)
IMAGE_REGISTRY_USERNAME=bhargavram0211

# Image tag/version (default: latest)
IMAGE_TAG=latest

# Backend URL (OPTIONAL - no longer needed for frontend build)
# The frontend now uses reverse proxy pattern with relative URLs (/api)
# This variable is kept for backward compatibility but not required
# BACKEND_URL=http://backend:8000

# CORS Origins (comma-separated list of allowed origins for backend)
# Note: With reverse proxy, CORS is less critical since frontend and backend
# appear to be on the same origin. However, if backend is accessed directly
# (e.g., for API docs at /docs), CORS still applies.
# For Docker Compose: use localhost or service name
# For production: use your domain(s)
# Example: http://localhost:3000,http://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:3000,http://127.0.0.1:8501

# Plaid API Configuration
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
